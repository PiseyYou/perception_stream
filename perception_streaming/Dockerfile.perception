# Perception Runtime Docker Image
# 使用 Ubuntu 22.04 并创建PCL 1.10的符号链接

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装所有必要的依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    libpcl-dev \
    libopencv-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# 创建PCL 1.10和OpenCV 4.2的符号链接（指向更新版本）
RUN cd /usr/lib/x86_64-linux-gnu && \
    # PCL 1.10 -> 1.12
    for lib in libpcl_*.so.1.12; do \
        base=$(echo $lib | sed 's/\.so\.1\.12$//'); \
        ln -sf $lib ${base}.so.1.10 || true; \
    done && \
    # OpenCV 4.2 -> 4.5
    for lib in libopencv_*.so.4.5*; do \
        base=$(echo $lib | sed 's/\.so\.4\.5.*$//'); \
        ln -sf $lib ${base}.so.4.2 || true; \
    done

# 复制程序和模型
WORKDIR /app
COPY lib/dnn_x86 /app/lib/dnn_x86
COPY bin/offline_perception_debug_432 /app/bin/
COPY bin/offline_test_main /app/bin/
COPY night_offline_debug/build/run_cdt_dsg_fusion_dir /app/bin/
COPY night_offline_debug/model /app/model/
COPY models /app/models/

# 设置库路径
ENV LD_LIBRARY_PATH=/app/lib/dnn_x86:/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH
ENV OFFLINE_INPUT_DIR=/app/input
ENV OFFLINE_OUTPUT_DIR=/app/output

# 运行命令（可被覆盖）
CMD ["python3", "-c", "import subprocess; print(subprocess.run(['ldd', '/app/bin/offline_test_main'], capture_output=True, text=True).stdout)"]
