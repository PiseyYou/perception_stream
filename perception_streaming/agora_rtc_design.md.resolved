## 6. 主页面 — `src/App.vue`

```vue
<template>
  <div style="max-width: 900px; margin: 0 auto; padding: 20px; font-family: sans-serif;">
    <h2>Agora RTC 推流测试</h2>

    <!-- ============ MQTT 连接表单 ============ -->
    <fieldset style="margin-bottom: 16px;">
      <legend>MQTT 连接配置</legend>
      <div class="form-grid">
        <label>协议</label>
        <select v-model="form.protocol">
          <option value="wss">wss://</option>
          <option value="ws">ws://</option>
        </select>

        <label>Broker 地址</label>
        <input v-model="form.broker" placeholder="mqtt-test.yjserver.com" />

        <label>端口</label>
        <input v-model.number="form.port" type="number" placeholder="8084" />

        <label>Client ID</label>
        <input v-model="form.clientId" />

        <label>用户名</label>
        <input v-model="form.username" placeholder="请输入用户名" />

        <label>密码</label>
        <input v-model="form.password" type="password" placeholder="请输入密码" />

        <label>Keep Alive(秒)</label>
        <input v-model.number="form.keepalive" type="number" />

        <label>重连间隔(ms)</label>
        <input v-model.number="form.reconnectPeriod" type="number" />
      </div>
    </fieldset>

    <!-- ============ 设备 & Agora 配置 ============ -->
    <fieldset style="margin-bottom: 16px;">
      <legend>设备 & Agora</legend>
      <div class="form-grid">
        <label>设备 SN</label>
        <input v-model="form.sn" placeholder="BM2411K2000001" />

        <label>Agora App ID</label>
        <input v-model="form.agoraAppId" placeholder="输入声网 App ID" />

        <label>相机类型</label>
        <select v-model.number="form.camera">
          <option :value="0">单目 (K100)</option>
          <option :value="100">三目拼接 (K200+)</option>
        </select>

        <label>分辨率等级</label>
        <select v-model.number="form.resolution">
          <option :value="0">640×480</option>
          <option :value="1">480×320</option>
          <option :value="2">320×240 (默认)</option>
          <option :value="3">240×180</option>
        </select>
      </div>
    </fieldset>

    <!-- ============ 操作按钮 ============ -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
      <button @click="handleConnectMqtt" :disabled="mqttConnected" style="background:#67c23a;color:#fff;">
        {{ mqttConnected ? 'MQTT 已连接' : '连接 MQTT' }}
      </button>
      <button @click="handleDisconnectMqtt" :disabled="!mqttConnected" style="background:#f56c6c;color:#fff;">
        断开 MQTT
      </button>
      <button @click="handleStartVideo" :disabled="!mqttConnected || videoStarted"
              style="background:#409eff;color:#fff;">
        开启视频
      </button>
      <button @click="handleStopVideo" :disabled="!videoStarted" style="background:#e6a23c;color:#fff;">
        关闭视频
      </button>
    </div>

    <!-- ============ 视频容器 ============ -->
    <div id="video-container"
         :style="{ width: form.camera === 0 ? '468px' : '1400px',
                    height: '350px', background: '#000', position: 'relative' }">
    </div>

    <!-- ============ 日志 ============ -->
    <fieldset style="margin-top: 16px;">
      <legend>日志</legend>
      <div style="height: 200px; overflow-y: auto; font-size: 12px; font-family: monospace; background: #1e1e1e; color: #d4d4d4; padding: 8px;">
        <div v-for="(log, i) in logs" :key="i">{{ log }}</div>
      </div>
    </fieldset>
  </div>
</template>

<script setup lang="ts">
import { ref, onBeforeUnmount } from 'vue'
import MqttClient from './utils/mqttClient'
import { joinChannel, leaveChannel } from './composables/useAgoraRTC'

// ==================== 表单数据 ====================
const form = ref({
  protocol: 'wss',
  broker: 'mqtt-test.yjserver.com',
  port: 8084,
  clientId: 'mqttx_' + Math.random().toString(16).substring(2, 10),
  username: '',
  password: '',
  keepalive: 60,
  reconnectPeriod: 4000,
  sn: '',
  agoraAppId: '',
  camera: 100,      // 0=单目, 100=三目拼接
  resolution: 2,    // 分辨率等级
})

// ==================== 状态 ====================
const mqttConnected = ref(false)
const videoStarted = ref(false)
const logs = ref<string[]>([])

const mqttClient = new MqttClient()

function addLog(msg: string) {
  logs.value.unshift(`[${new Date().toLocaleTimeString()}] ${msg}`)
}

// ==================== MQTT 连接 ====================
function handleConnectMqtt() {
  const f = form.value
  if (!f.broker || !f.username || !f.password || !f.sn) {
    alert('请填写 Broker 地址、用户名、密码、SN')
    return
  }

  const brokerUrl = `${f.protocol}://${f.broker}:${f.port}/mqtt`

  mqttClient.init({
    brokerUrl,
    clientId: f.clientId,
    username: f.username,
    password: f.password,
    keepalive: f.keepalive,
    clean: true,
    reconnectPeriod: f.reconnectPeriod,
  })

  const result = mqttClient.connect()
  if (result === 'connect') {
    mqttConnected.value = true
    addLog(`MQTT 连接中... ${brokerUrl}`)

    // 订阅主题
    const sn = f.sn
    const subTopics = [
      `bestmow/respond/${sn}`,
      `bestmow/status_report/${sn}`,
    ]
    mqttClient.subscribe(subTopics, (topic, message) => {
      try {
        const json = JSON.parse(message)
        addLog(`[${topic}] ${json.operation || 'unknown'}`)

        // 机器确认开启视频 → 加入 Agora 频道
        if (json.operation === 'mow_enable_remote_rtsp' && json.success === true) {
          addLog('机器确认推流, 加入 Agora 频道...')
          joinChannel(f.agoraAppId, sn)
          videoStarted.value = true
        }
      } catch {
        addLog(`[${topic}] ${message}`)
      }
    })
  } else {
    addLog('MQTT 已连接')
  }
}

function handleDisconnectMqtt() {
  if (videoStarted.value) handleStopVideo()
  const result = mqttClient.disconnect()
  mqttConnected.value = false
  addLog(result)
}

// ==================== 视频控制 ====================
function handleStartVideo() {
  const f = form.value
  if (!f.agoraAppId) {
    alert('请填写 Agora App ID')
    return
  }

  // 通过 MQTT 通知机器端开始推流
  const message = {
    msg_id: f.username,
    operation: 'mow_enable_remote_rtsp',
    timestamp: Date.now(),
    payload: {
      appid: f.agoraAppId,
      license: '',
      token: 'web1',
      resolution_level: f.resolution,
      camera: f.camera,
    },
  }

  const topic = `bestmow/request/${f.sn}`
  const result = mqttClient.publish(topic, JSON.stringify(message))
  if (result === 'success') {
    addLog(`已发送开启视频指令 → ${topic}`)
  } else {
    addLog(`发送失败: ${result}`)
  }
}

async function handleStopVideo() {
  // 1. 离开 Agora 频道
  await leaveChannel()
  videoStarted.value = false

  // 2. 通知机器端停止推流
  const f = form.value
  const message = {
    msg_id: f.username,
    operation: 'mow_disable_remote_rtsp',
    timestamp: Date.now(),
    payload: { appid: '', license: '', token: 'web1' },
  }
  mqttClient.publish(`bestmow/request/${f.sn}`, JSON.stringify(message))
  addLog('已关闭视频')
}

// ==================== 清理 ====================
onBeforeUnmount(() => {
  if (videoStarted.value) handleStopVideo()
  mqttClient.destroy()
})
</script>

<style>
button {
  padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;
}
button:disabled { opacity: 0.5; cursor: not-allowed; }
fieldset { border: 1px solid #ddd; border-radius: 6px; padding: 12px; }
legend { font-weight: bold; }
.form-grid {
  display: grid; grid-template-columns: 120px 1fr; gap: 8px; align-items: center;
}
.form-grid label { text-align: right; font-size: 13px; }
.form-grid input, .form-grid select {
  padding: 6px 8px; border: 1px solid #ccc; border-radius: 4px; font-size: 13px;
}
</style>
```

