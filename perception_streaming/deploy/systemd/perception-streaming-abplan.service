[Unit]
Description=Perception Streaming A/B shadow prelabel web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/media/sdc2/yf/ABplan/perception_streaming
Environment=PATH=/home/server2/.npm-global/n/versions/node/22.11.0/bin:/home/server2/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHON=/usr/bin/python3
Environment=MPFORMER_ROOT=/media/sdc2/lhx/MPformer
Environment=PERCEPTION_STREAMING_PORT=5174
Environment=OFFLINE_SERVER_PORT=8770
Environment=ENABLE_ROBOT_BRIDGE=0
Environment=VITE_DEV_OPEN=0
Environment=VITE_CJS_IGNORE_WARNING=true
Environment=CHOKIDAR_USEPOLLING=false
EnvironmentFile=/home/server2/.config/perception-streaming/cvat.env
ExecStart=/home/server2/.npm-global/n/versions/node/22.11.0/bin/npm run dev -- --host 0.0.0.0
Restart=always
RestartSec=3
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=20
LimitNOFILE=65536

[Install]
WantedBy=default.target
